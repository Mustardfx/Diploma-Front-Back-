# ─── База данных ────────────────────────────────────────────────
PORT_ENV=8080
DB_HOST=sportportal-db
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=pass123
DB_NAME=sportportal

# ─── Аутентификация ─────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string

# ─── Почта (сброс пароля) ───────────────────────────────────────
# Пример для Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=ваш@gmail.com, SMTP_PASS=app-password (App Password, не обычный пароль).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=СпортПортал <no-reply@sportportal.local>

# Базовый URL фронтенда — используется в ссылке сброса пароля
APP_URL=http://localhost:5173
